# Copy to .env and fill in values there. Do not commit .env.
# Generate SESSION_SECRET and TOKEN_ENCRYPTION_KEY locally; do not reuse example text.

PORT=10000
RATE_NINJA_BASE_URL=https://rateninja.co
RATE_NINJA_CLIENT_ID=
RATE_NINJA_CLIENT_SECRET=
OCEANRELAY_REDIRECT_URI=https://oceanrelay.ai/oauth/callback
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
OCEANRELAY_STORE_PATH=data/oceanrelay-store.json
OCEANRELAY_RECORDS_PATH=data/oceanrelay-records.json
OCEANRELAY_OPERATOR_SUBS=

# Chain client. All four secrets are required together. Leave them blank to keep the chain off.
OCEANRELAY_RELAYER_KEY=
OCEANRELAY_REGISTRAR_KEY=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# FORTEL2_READ_RPC=https://fortel2-sequencer-rpc.onrender.com/
# FORTEL2_WRITE_RPC=https://fortel2-write.ente.ltd
# OCEANRELAY_CHAIN_MAX_FEE_GWEI=1
